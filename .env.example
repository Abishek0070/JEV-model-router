# Copy to .env for local dev. All keys optional — router falls back to mock provider.
PORT=4000
CONFIG_PATH=./config.example.yaml
LOG_LEVEL=info

# JEV endpoints — set ONE key and you're routed. Order: typesafe -> openrouter -> local.
# JEV_API_KEY is the simple alias for the TypeSafe key.
JEV_API_KEY=
JEV_TYPESAFE_URL=https://api.typesafe.ai/v1/decisions
JEV_TYPESAFE_MODEL=jev-latest
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_JEV_MODEL=typesafe/jev-1

# LLM providers (BYOK — only set what you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Gateway auth (optional; leave empty to accept any key in dev)
GATEWAY_API_KEYS=
